{
  "name": "ys-mobile-template",
  "version": "0.1.0",
  "private": true,
  "license": "0BSD",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:yorkstead": "node --test tests/yorkstead.test.mjs",
    "yorkstead:check": "node scripts/yorkstead-check.mjs",
    "yorkstead:init": "node scripts/yorkstead-init.mjs",
    "verify": "npm run yorkstead:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:yorkstead"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo-router": "~57.0.28",
    "expo-linking": "~57.0.13",
    "react-native": "0.86.3",
    "expo-constants": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react-native-web": "~0.21.0",
    "expo-splash-screen": "~57.0.10",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "expo-dev-client": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-updates": "~57.0.26",
    "nativewind": "4.2.7",
    "react-native-css-interop": "0.2.7",
    "@tanstack/react-query": "^5.90.0",
    "zustand": "^5.0.8",
    "react-hook-form": "^7.65.0",
    "@hookform/resolvers": "^5.2.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/jest": "^30.0.0",
    "typescript": "~6.0.3",
    "tailwindcss": "~3.4.19",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.6.2",
    "jest": "^30.2.0",
    "jest-expo": "~57.0.6",
    "@testing-library/react-native": "^13.3.3",
    "react-test-renderer": "19.2.3"
  }
}
